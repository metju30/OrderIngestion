{
  "ConnectionStrings": {
    // SQLite connection string
    "DefaultConnection": "Data Source=orders.db"
  },
  "OrderSource": {
    "BaseUrl": "https://jsonplaceholder.typicode.com/"
  },
  "Ingestion": {
    "Mode": "Sqlite", // "Sqlite" | "File"
    "FileQueuePath": "data/orders-queue.jsonl", // used only in File mode
    "IntervalMinutes": 15,
    "ImportIntervalSeconds": 30 // importer drain cadence
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ingestion-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{RunKind}] [{RunId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}